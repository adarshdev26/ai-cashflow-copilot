// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plans {
  FREEMIUM
  PREMIUM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  WALLET
  OTHER
}

enum CategoryType {
  CREDIT
  DEBIT
  BOTH
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  password              String
  name                  String?
  createdAt             DateTime              @default(now())
  ownedWorkspaces       Workspace[]           @relation("WorkspaceOwner") // workspaces I own
  workspaceAccess       WorkspaceAccess[] // every workspace I can access (owned + shared)
  sentInvitations       WorkspaceInvitation[] @relation("InvitationInviter") // invites I created
  updatedAt             DateTime              @updatedAt
  role                  Role                  @default(USER)
  plan                  Plans                 @default(FREEMIUM)
  onboardingCompletedAt DateTime? // null = still needs onboarding
  primaryGoal           String?
  passwordChangedAt     DateTime?
  passwordResetTokens   PasswordResetToken[]
  isActive              Boolean               @default(true)
  preference            UserPreference?
  supportTickets        SupportTicket[]
}

model Admin {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  name              String?
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Workspace {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  currency              String                 @default("INR")
  ownerId               String
  owner                 User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  access                WorkspaceAccess[]
  invitations           WorkspaceInvitation[]
  categories            Category[]
  transactions          Transaction[]
  accounts              FinancialAccount[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  transactionTemplates  TransactionTemplate[]
  isActive              Boolean                @default(true)
  setting               WorkspaceSetting?
  goals                 Goal[]

  @@index([ownerId])
}

model WorkspaceAccess {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

// Pending/used/cancelled invitation to join a workspace.
// The raw token is never stored: only its SHA-256 hash.
model WorkspaceInvitation {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String // always stored lowercase + trimmed
  role        WorkspaceRole // API must only allow ADMIN | MEMBER | VIEWER (never OWNER)
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, email])
}

// Global: shared by every workspace
model Category {
  id                    String                 @id @default(uuid())
  name                  String
  color                 String?
  // null = global (shared by every workspace). Set = custom, visible only in that workspace.
  workspaceId           String?
  workspace             Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  type                  CategoryType           @default(BOTH)
  isActive              Boolean                @default(true)
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  transactionTemplates  TransactionTemplate[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, isActive])
}

// Workspace-scoped money container (bank, cash, card, wallet).
// Named FinancialAccount to avoid confusion with WorkspaceAccess.
model FinancialAccount {
  id                    String                 @id @default(uuid())
  workspaceId           String
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                  String
  type                  AccountType            @default(OTHER)
  currency              String                 @default("INR")
  openingBalance        Float                  @default(0)
  recurringTransactions RecurringTransaction[]
  isActive              Boolean                @default(true)
  transactions          Transaction[]          @relation("TransactionAccount")
  incomingTransfers     Transaction[]          @relation("TransactionToAccount")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  transactionTemplates  TransactionTemplate[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("financial_accounts")
}

model Transaction {
  id                     String                @id @default(uuid())
  amount                 Float
  type                   TransactionType       @default(DEBIT)
  description            String?
  workspaceId            String
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId             String?
  category               Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Nullable for now; becomes required after the backfill (Commit 13).
  // Restrict: an account with transactions can never be hard-deleted.
  accountId              String?
  account                FinancialAccount?     @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  // Set only for transactions generated by a schedule.
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  occurrenceDate         DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  toAccountId            String?
  toAccount              FinancialAccount?     @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  // DB-level idempotency: one transaction per schedule + occurrence.
  // Manual transactions (NULLs) are never affected.
  @@unique([workspaceId, recurringTransactionId, occurrenceDate])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, accountId])
  @@index([workspaceId, categoryId, createdAt])
  @@index([recurringTransactionId])
  @@index([workspaceId, toAccountId])
}

enum TransactionType {
  CREDIT
  DEBIT
  TRANSFER
}

enum BudgetPeriod {
  MONTHLY
}

model Budget {
  id          String       @id @default(cuid())
  workspaceId String
  categoryId  String
  amount      Float
  period      BudgetPeriod @default(MONTHLY)
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, categoryId, period])
  @@index([workspaceId, isActive])
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id          String             @id @default(uuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  categoryId  String?
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String?
  amount      Float
  type        TransactionType
  frequency   RecurringFrequency
  // Calendar dates stored at 12:00 UTC (see src/lib/recurring-dates.ts)
  startDate   DateTime
  endDate     DateTime?
  // Next occurrence NOT yet generated. Server-computed, never client input.
  nextRunAt   DateTime
  isActive    Boolean            @default(true)
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  generatedTransactions Transaction[]

  @@index([workspaceId, isActive])
  @@index([isActive, nextRunAt])
  @@index([workspaceId, accountId])
}

enum TemplateDateMode {
  FIXED // always use fixedDate
  TODAY // use the day the template is applied
}

model TransactionTemplate {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        TransactionType   @default(DEBIT)
  amount      Float?
  description String?
  accountId   String?
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dateMode    TemplateDateMode  @default(TODAY)
  fixedDate   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model SystemSetting {
  key              String   @id
  value            Json
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
}

model UserPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  values    Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model WorkspaceSetting {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values      Json      @default("{}")
  updatedAt   DateTime  @updatedAt
}

model SettingsAudit {
  id           String   @id @default(uuid())
  scope        String
  scopeId      String?
  key          String
  actorAdminId String?
  actorUserId  String?
  oldValue     Json?
  newValue     Json
  createdAt    DateTime @default(now())

  @@index([scope, createdAt])
}

enum SupportTicketStatus {
  PENDING
  PROCESSING
  RESOLVED
}

model SupportTicket {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String              @db.VarChar(200)
  message      String              @db.Text
  status       SupportTicketStatus @default(PENDING)
  processingAt DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum ActorType {
  ADMIN
  USER
  SYSTEM
}

// General activity log. Append-only: never update or delete rows from app code.
// actorId / resourceId / workspaceId are plain strings on purpose (no relations),
// so history survives deletion of users, workspaces and other resources.
model AuditLog {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  actorId      String?
  actorType    ActorType
  actorName    String? // snapshot at time of action
  actorEmail   String? // snapshot at time of action
  action       String // e.g. "user.suspended"
  resourceType String // e.g. "user", "workspace"
  resourceId   String?
  workspaceId  String?
  metadata     Json? // safe before/after values, extra details
  ip           String?
  userAgent    String?

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model Goal {
  id            String     @id @default(uuid())
  workspaceId   String
  name          String
  targetAmount  Float
  currentAmount Float      @default(0)
  targetDate    DateTime
  description   String?
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([workspaceId, status, targetDate])
  @@index([workspaceId, createdAt])
}

model GoalContribution {
  id        String               @id @default(uuid())
  goalId    String
  kind      GoalContributionKind
  amount    Float
  createdAt DateTime             @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

enum GoalContributionKind {
  ADD
  REMOVE
}

enum GoalStatus {
  ACTIVE
  ARCHIVED
}
