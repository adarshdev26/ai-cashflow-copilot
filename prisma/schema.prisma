// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  WALLET
  OTHER
}

enum CategoryType {
  CREDIT
  DEBIT
  BOTH
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  password              String
  name                  String?
  createdAt             DateTime              @default(now())
  ownedWorkspaces       Workspace[]           @relation("WorkspaceOwner") // workspaces I own
  workspaceAccess       WorkspaceAccess[] // every workspace I can access (owned + shared)
  sentInvitations       WorkspaceInvitation[] @relation("InvitationInviter") // invites I created
  Habit                 Habit[]
  Note                  Note[]
  updatedAt             DateTime              @updatedAt
  role                  Role                  @default(USER)
  onboardingCompletedAt DateTime? // null = still needs onboarding
  primaryGoal           String? // saved during onboarding, not used anywhere yet
}

model Workspace {
  id           String                @id @default(uuid())
  name         String
  slug         String                @unique
  currency     String                @default("INR")
  ownerId      String
  owner        User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  access       WorkspaceAccess[]
  invitations  WorkspaceInvitation[]
  categories   Category[]
  transactions Transaction[]
  accounts     FinancialAccount[]
  habits       Habit[]
  notes        Note[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([ownerId])
}

model WorkspaceAccess {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

// Pending/used/cancelled invitation to join a workspace.
// The raw token is never stored: only its SHA-256 hash.
model WorkspaceInvitation {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String // always stored lowercase + trimmed
  role        WorkspaceRole // API must only allow ADMIN | MEMBER | VIEWER (never OWNER)
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, email])
}

// Global: shared by every workspace
model Category {
  id           String        @id @default(uuid())
  name         String
  color        String?
  // null = global (shared by every workspace). Set = custom, visible only in that workspace.
  workspaceId  String?
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  type         CategoryType  @default(BOTH)
  isActive     Boolean       @default(true)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, isActive])
}

// Workspace-scoped money container (bank, cash, card, wallet).
// Named FinancialAccount to avoid confusion with WorkspaceAccess.
model FinancialAccount {
  id             String        @id @default(uuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType   @default(OTHER)
  currency       String        @default("INR")
  openingBalance Float         @default(0)
  isActive       Boolean       @default(true)
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("financial_accounts")
}

model Transaction {
  id          String            @id @default(uuid())
  amount      Float
  type        TransactionType   @default(DEBIT)
  description String?
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Nullable for now; becomes required after the backfill (Commit 13).
  // Restrict: an account with transactions can never be hard-deleted.
  accountId   String?
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId, createdAt])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, accountId])
}

enum TransactionType {
  CREDIT
  DEBIT
}

model Habit {
  id          String     @id @default(uuid())
  title       String
  userId      String // creator
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId])
  @@index([userId])
}

model HabitLog {
  id        String   @id @default(uuid())
  completed Boolean  @default(false)
  date      DateTime @default(now())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, date])
}

model Note {
  id          String    @id @default(uuid())
  title       String
  content     String?
  userId      String // creator
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@index([userId])
}
